# Nova Server – Grok-Bot-Anbindung
# Kopiere diese Datei nach .env und trage die Werte aus dem Routine-Panel ein.
# .env ist in .gitignore und darf nie eingecheckt oder geteilt werden.

# Webhook-URL der Grok-Bot-Routine "Nova Inbox"
GROKBOT_WEBHOOK_URL=
# Webhook-Schlüssel (geheim!)
GROKBOT_WEBHOOK_KEY=

# Optional: Zugangscode, den Nova mitschicken muss (in Nova unter Grok Bot → Einstellungen eintragen)
NOVA_APP_TOKEN=
# Schlüssel für Geräte-Token (Kopplung per Code), z. B. `openssl rand -hex 32`. Ändern = alle Geräte abmelden
NOVA_DEVICE_SECRET=
# Optional: weitere erlaubte Origins, kommagetrennt (gleiche Origin ist immer erlaubt)
ALLOWED_ORIGINS=
# Optional: max. Anfragen pro Minute und IP (Standard 10)
RATE_LIMIT_PER_MINUTE=10
# Port für den lokalen Server (Standard 8787)
PORT=8787

# --- Kalender ---
# Google Kalender (eigener OAuth-Client aus der Google Cloud Console, Typ "Webanwendung")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Muss exakt so in der Google Cloud Console als "Autorisierte Weiterleitungs-URI" eingetragen sein
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=Europe/Berlin
# Apple Kalender Abo-Feed: langer Zufallswert, z. B. `openssl rand -hex 24`
CALENDAR_FEED_TOKEN=
# Öffentliche Basis-URL des Servers (für Feed-Links), z. B. https://nova-api.example.com
PUBLIC_BASE_URL=

# --- Mitteilungen (Web Push) ---
# Mit `npm run gen:vapid` erzeugen – nicht von Hand eintragen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nova@example.invalid

# --- Nova Chat (xAI) ---
# xAI-API-Schlüssel (https://console.x.ai) – bleibt ausschließlich auf dem Server
XAI_API_KEY=
# Modell (Standard grok-4.7)
XAI_MODEL=grok-4.7
# Optional: andere OpenAI-kompatible Basis-URL (Standard https://api.x.ai/v1)
XAI_BASE_URL=
# Optional: max. Antwort-Tokens, Timeouts, Chat-Anfragen pro Minute und IP
XAI_MAX_TOKENS=2048
XAI_TIMEOUT_MS=45000
CHAT_RATE_LIMIT_PER_MINUTE=20
