{
  "name": "nova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nova – persönliche Assistentin (PWA)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server": "node server/node.js",
    "start": "npm run build && node server/node.js",
    "gen:vapid": "node server/scripts/gen-vapid.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "browserslist": "^4.29.5",
    "lightningcss": "^1.33.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@event-calendar/core": "^5.18.1",
    "@hono/node-server": "^2.1.7",
    "hono": "^4.13.18",
    "web-push": "^3.6.7"
  }
}
